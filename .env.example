# jvn environment — copy to `.env` and fill in what you need.
# Lookup order: real environment wins, then this file, then ~/.config/jvn/env.

# --- Single decision service (simple setup) ---------------------------------
# The TypeSafe Jev endpoint (default) or any wire-compatible System-One service:
#TYPESAFE_API_KEY=tsk-...
#TYPESAFE_BASE_URL=https://api.typesafe.ai
#TYPESAFE_DEFAULT_MODEL=jev-latest

# Drex by Nace.AI — the same SDK, different endpoint:
#TYPESAFE_API_KEY=nace-...
#TYPESAFE_BASE_URL=https://drex.nace.ai
#TYPESAFE_DEFAULT_MODEL=drex-latest

# --- Route table: named routes with automatic fallback ----------------------
# The first route is primary; when a call fails, the next is asked.
#SYSTEM_ONE_ROUTES=drex,jev
# Known routes take a shorthand flag (endpoint+model defaults):
#SYSTEM_ONE_DREX=1
#SYSTEM_ONE_JEV=1
# Per-route keys override TYPESAFE_API_KEY; per-route endpoint/model override the shorthand:
#SYSTEM_ONE_DREX_API_KEY=nace-...
#SYSTEM_ONE_JEV_API_KEY=tsk-...
# A finetuned decider is just another route — any endpoint speaking POST /v1/systemone:
#SYSTEM_ONE_ROUTES=decider,jev
#SYSTEM_ONE_DECIDER_ENDPOINT=http://localhost:8900
#SYSTEM_ONE_DECIDER_MODEL=decider-4b-v1
#SYSTEM_ONE_DECIDER_API_KEY=local-dev
